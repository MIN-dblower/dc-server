{
  "name": "scrape-engine",
  "version": "0.1.0",
  "description": "A boilerplate for Puppeteer + TypeScript",
  "repository": "https://github.com/sosmii/puppeteer-typescript-boilerplate",
  "author": "sosmii",
  "license": "MIT",
  "private": true,
  "scripts": {
    "lint": "tslint ./src/**/*.ts",
    "fix": "tslint --fix ./src/**/*.ts",
    "start": "dotenv -e .env -- ts-node src/index.ts",
    "build": "tsc && tscpaths -p tsconfig.json -s ./src -o ./build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:processQuestionAnswer": "jest src/services/__tests__/processQuestionAnswer.test.ts",
    "test:stringSimilarity": "ts-node src/utils/__tests__/stringSimilarity.test.ts",
    "test:stringSimilarity:compare": "ts-node src/utils/__tests__/stringSimilarityComparison.test.ts",
    "dev:monitor": "dotenv -e .env -- ts-node src/workers/auctionMonitor.ts",
    "dev:dc-sync": "dotenv -e .env -- ts-node src/workers/dcSyncWorker.ts",
    "dev:telegram": "dotenv -e .env -- ts-node src/workers/telegramWorker.ts",
    "dev:start": "npm-run-all --parallel dev:monitor dev:dc-sync dev:telegram",
    "dev:dashboard": "dotenv -e .env -- ts-node src/workers/queueDashboard.ts",
    "prod:monitor": "node build/workers/auctionMonitor.js",
    "prod:dc-sync": "node build/workers/dcSyncWorker.js",
    "prod:telegram": "node build/workers/telegramWorker.js",
    "prod:start": "npm-run-all --parallel prod:monitor prod:dc-sync prod:telegram",
    "prod:dashboard": "node build/workers/queueDashboard.js"
  },
  "pre-commit": [
    "lint"
  ],
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/ioredis": "^4.28.10",
    "@types/lodash": "^4.17.17",
    "@types/luxon": "^3.7.1",
    "@types/node": "^10.14.13",
    "@types/node-telegram-bot-api": "^0.64.12",
    "@types/papaparse": "^5.3.16",
    "@types/jest": "^29.5.0",
    "@types/puppeteer": "^1.12.4",
    "dotenv": "^17.2.3",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "dotenv-cli": "^8.0.0",
    "pre-commit": "^1.2.2",
    "prettier": "^1.18.2",
    "prisma": "^6.17.0",
    "puppeteer": "^1.18.1",
    "ts-node": "^7.0.1",
    "tslint": "^5.18.0",
    "tslint-config-prettier": "^1.18.0",
    "tslint-plugin-prettier": "^2.0.1"
  },
  "dependencies": {
    "@bull-board/api": "^6.14.2",
    "@bull-board/express": "^6.14.2",
    "@prisma/client": "^6.17.0",
    "@types/uuid": "^10.0.0",
    "axios": "^1.8.2",
    "bullmq": "^5.63.2",
    "cheerio": "^1.0.0",
    "express": "^4.21.2",
    "google-auth-library": "^10.5.0",
    "googleapis": "^166.0.0",
    "ioredis": "^5.8.2",
    "lodash": "^4.17.21",
    "luxon": "^3.4.4",
    "node-telegram-bot-api": "^0.66.0",
    "papaparse": "^5.5.3",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "string-similarity-js": "^2.1.4",
    "tsconfig-paths": "^4.2.0",
    "tscpaths": "^0.0.9",
    "typescript": "^5.8.2",
    "uuid": "^12.0.0",
    "zod": "^3.24.2"
  }
}
